# =============================================================
# VOSCCTV NVR Console Environment Configuration Template
# =============================================================

# Server Port
PORT=8090

# Dashboard Operator Authentication
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=admin

# Dahua NVR Credentials
NVR_USER=iot
NVR_PASSWORD=iot12345

# NVR Target IP Addresses
NVR1_IP=192.168.1.200
NVR2_IP=192.168.1.181

# Authentication Toggle (true to enforce login, false for open kiosk mode)
AUTH_ENABLED=true
