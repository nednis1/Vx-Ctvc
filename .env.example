# Server Port
PORT=8090

# Directus Master Database Configuration
DIRECTUS_URL=http://goatedcodoer:8056
DIRECTUS_TOKEN=AAKv73dkIV8DfAIA5vEt3eXVdIebzmBW

# Dashboard Operator Authentication
# Generate a salted scrypt hash with: npm run hash-password -- <your-password>
DASHBOARD_USER=iot
DASHBOARD_PASSWORD_HASH=
# Legacy/plaintext fallback (hashed in memory on startup if DASHBOARD_PASSWORD_HASH is unset)
DASHBOARD_PASSWORD=iot12345

# Dahua NVR Credentials (raw credentials required by NVR RTSP & Digest auth)
NVR_USER=iot
NVR_PASSWORD=iot12345

# NVR Target IP Addresses
NVR1_IP=192.168.1.200
NVR2_IP=192.168.1.181

# Authentication Toggle (true to enforce login, false for open kiosk mode)
AUTH_ENABLED=true

