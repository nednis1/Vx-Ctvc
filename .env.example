# =============================================================
# VOSCCTV NVR Console Environment Configuration Template
# Copy this file to `.env` on the target server and fill in values.
# Never commit `.env` to Git.
# =============================================================

PORT=8090

# Set to `true` only when running behind a trusted reverse proxy (Nginx / Caddy / Cloudflare Tunnel)
TRUST_PROXY=false

# Cookie Secure flag: `auto` (adds Secure over HTTPS), `true` (always), or `false` (never)
COOKIE_SECURE=auto

# Directus Master Database Configuration
DIRECTUS_URL=http://goatedcodoer:8056
DIRECTUS_TOKEN=

# Dashboard Operator Authentication (generate hash with: node scripts/hash-password.js <password>)
DASHBOARD_USER=iot
DASHBOARD_PASSWORD_HASH=

# Dahua NVR Hardware Credentials (used for RTSP / HTTP Digest against NVRs)
NVR_USER=iot
NVR_PASSWORD=

# NVR Target IP Addresses
NVR1_IP=192.168.1.200
NVR2_IP=192.168.1.181

# Authentication Toggle (true = login required, false = open kiosk)
AUTH_ENABLED=true

# Playback Lock PIN (generate hash with: node scripts/hash-password.js <pin>)
PLAYBACK_PIN_HASH=
PLAYBACK_LOCK_TTL_MINUTES=15
